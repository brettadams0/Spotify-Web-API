# Copy to .env and fill in. Never commit the real file.

# Create an app at https://developer.spotify.com/dashboard and copy these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must match a Redirect URI registered on that Spotify app, exactly.
# Local development:
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback
# Production, for example:
# SPOTIFY_REDIRECT_URI=https://your-app.onrender.com/callback

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true when serving over HTTPS so the session cookie is secure-only.
SESSION_COOKIE_SECURE=false

# Seconds an upstream Spotify response may be reused. 0 disables caching.
CACHE_TTL=120

# Development only.
FLASK_DEBUG=false
PORT=5000
